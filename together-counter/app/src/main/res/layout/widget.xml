<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="3dp"
    android:background="@android:color/transparent">
    <TextView android:id="@+id/names" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Andries 💛💙💚 Crisstel" android:textColor="#FFFFFFFF" android:textSize="16sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowRadius="4" />
    <TextView android:id="@+id/together" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Together for" android:textColor="#FFFFFFFF" android:textSize="11sp" />
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center" android:orientation="horizontal">
        <TextView android:id="@+id/days" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="000 DAYS" android:textColor="#FFFFFFFF" android:textSize="21sp" android:textStyle="bold" android:shadowColor="#CC000000" android:shadowRadius="4" />
        <Chronometer android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFFFF" android:textSize="21sp" android:fontFamily="monospace" android:textStyle="bold" android:format=" %s" />
    </LinearLayout>
</LinearLayout>